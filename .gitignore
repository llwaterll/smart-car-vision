# dot files
/.vscode

# Keil µVision 用户 GUI 布局（含本机用户名，不入库）
MDK-ARM/*.uvguix.*

# project out
MDK-ARM/build
MDK-ARM/bin
MDK-ARM/obj
MDK-ARM/out

# Keil 编译输出目录（uvprojx 里的 OutputDirectory）及常见默认输出目录
MDK-ARM/NEUQ_STM32F407VET6_Opensource_Library/
MDK-ARM/Objects/
MDK-ARM/Listings/

# 编译中间产物 / 固件（防止散落在其他目录时被误提交）
*.o
*.d
*.crf
*.dep
*.lst
*.map
*.axf
*.elf
*.hex
*.bin
*.lnp
*.htm
*.build_log.htm

# Keil 调试器日志
JLinkLog.txt
JLinkSettings.ini

# Keil 命令行构建/烧录日志（UV4 -o 输出，仅本地诊断用）
MDK-ARM/uv4_*.log

# 自动生成的 RTE 头文件（Keil 在 RTE/_<target>/，EIDE 在 MDK-ARM/ 根目录）
MDK-ARM/RTE/_*/
MDK-ARM/RTE_Components.h

# EIDE 复制的芯片支持包（约 90MB，克隆后在 EIDE 里重新安装即可，Keil 不依赖它）
MDK-ARM/.pack/

# CMSIS 工具生成的缓存（与 Library/HAL_lib/Core/Inc 内头文件重复）
MDK-ARM/.cmsis/

# Python 缓存
__pycache__/

# Local firmware verification output and extracted reference diagrams
/build/

# eide template
*.ept
*.eide-template

# 备份文件
*.bak
*.orig

# EIDE 工程文件已入库：克隆后直接打开仓库根目录即可编译。
# 注意：EIDE 构建时可能自动改写 eide.yml，提交前确认路径没有变成本机绝对路径。
# 根目录 .eide/ 与 MDK-ARM/.eide/ 各保留一份，分别对应两种打开方式。

# Agent Team 办公目录（本地协作产物）
/.team/
MDK-ARM/.team/

# 本地临时目录、主题缓存与编辑器日志
/tmp/
/vofa_dark/
MDK-ARM/.vscode/

# Archify 生成的架构图页面（构建产物，不入库）
MDK-ARM/.archify/

# 旧版本库备份（重建仓库时生成，仅本地保留）
/.git.backup-*/

# 一次性发布辅助脚本（不属于工程源码）
MDK-ARM/.prepare_github_commit.py
MDK-ARM/.publish_car_comments.py

# 本机香橙派 WiFi 登录脚本（含明文 WiFi 密码，不入库）
Tools/pi_wifi_serial.ps1

# Linux vision executables and generated replay output
/vision_inspection/vision/vision
/vision_inspection/vision/main
/vision_inspection/vision/test_frontend
/vision_inspection/vision/test_gap
/vision_inspection/vision/test_obstacles
/vision_inspection/vision/test_obstacle_task
/vision_inspection/vision/test_vision_link
